{
  "name": "4d-v20-vscode",
  "displayName": "4D v20 Language Support",
  "description": "Modern 4D v20 language support including syntax highlighting, snippets, and basic formatting.",
  "version": "0.1.3",
  "license": "MIT",
  "publisher": "jaimealvarezv",
  "icon": "images/icon.png",
  "author": {
    "name": "Jaime Alvarez"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalvarez/4d-v20-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "4d",
        "aliases": [
          "4D",
          "4d"
        ],
        "extensions": [
          ".4dm",
          ".4d",
          ".4dproject",
          ".4dform"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "4d",
        "scopeName": "source.4d",
        "path": "./syntaxes/4d.tmLanguage.json"
      }
    ],

    "snippets": [
      {
        "language": "4d",
        "path": "./snippets/4d.json"
      }
    ],
    "commands": [
      {
        "command": "4d.checkSyntax",
        "title": "4D: Check Syntax",
        "category": "4D"
      },
      {
        "command": "4d.compile",
        "title": "4D: Compile Project",
        "category": "4D"
      },
      {
        "command": "4d.runMethod",
        "title": "4D: Run Method...",
        "category": "4D"
      },
      {
        "command": "4d.newClass",
        "title": "4D: New Class",
        "category": "4D"
      },
      {
        "command": "4d.newProject",
        "title": "4D: New Project",
        "category": "4D"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "4d.checkSyntax",
          "group": "navigation",
          "when": "resourceLangId == 4d"
        },
        {
          "command": "4d.runMethod",
          "group": "navigation",
          "when": "resourceLangId == 4d"
        }
      ],
      "commandPalette": [
        {
          "command": "4d.checkSyntax",
          "when": "editorLangId == 4d"
        },
        {
          "command": "4d.compile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "4d.checkSyntax",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && editorLangId == 4d"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "4d-explorer",
          "title": "4D Explorer",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "4d-explorer": [
        {
          "id": "4d.methods",
          "name": "Methods",
          "icon": "images/icon.png"
        },
        {
          "id": "4d.classes",
          "name": "Classes",
          "icon": "images/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "4D v20",
      "properties": {
        "4d.uppercaseKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Uppercase 4D keywords on format (e.g., 'if' -> 'If')."
        },
        "4d.server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "4D Server Hostname or IP."
        },
        "4d.server.port": {
          "type": "number",
          "default": 8080,
          "description": "4D Server REST Port."
        },
        "4d.server.username": {
          "type": "string",
          "default": "Administrator",
          "description": "4D Server Username."
        },
        "4d.compiler.options": {
          "type": "string",
          "default": "",
          "description": "Additional compiler options."
        },
        "4d.editor.autoFormat": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-formatting on save."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ./node_modules/typescript/bin/tsc -p ./",
    "watch": "./node_modules/.bin/tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "./node_modules/.bin/eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.57.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.4",
    "@vscode/test-electron": "^2.3.0"
  }
}
